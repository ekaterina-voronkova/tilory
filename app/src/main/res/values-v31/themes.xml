<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch splash: a plain colour only; the app draws its own launch screen right after (#33, #53). -->
    <style name="Theme.Tilory" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
